FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG QUARTO_VERSION=1.9.38

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libgomp1 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/translation-ci \
    && /opt/translation-ci/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/translation-ci/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.7.1

COPY experiments/scaling-my-posts/requirements/benchmark.txt /tmp/benchmark.txt
RUN /opt/translation-ci/bin/pip install --no-cache-dir -r /tmp/benchmark.txt

RUN curl --fail --location --show-error \
        --output /tmp/quarto.deb \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" \
    && apt-get update \
    && apt-get install --yes --no-install-recommends /tmp/quarto.deb \
    && rm -f /tmp/quarto.deb \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/translation-ci/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/model-cache \
    TOKENIZERS_PARALLELISM=false

WORKDIR /workspace

ENTRYPOINT ["python", "experiments/scaling-my-posts/src/local_ci.py"]
